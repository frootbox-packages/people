{#- A new person as a draft (decision 0226). -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}

{% block title %}{{ t('New person') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <p class="fb-muted"><a href="{{ path('frootbox.people.people') }}">{{ t('People') }}</a></p>
            <h1 class="fb-heading-1">{{ t('New person') }}</h1>
        </div>
    </header>

    <fb-form action="frootbox/people/person.create" next="{{ path('frootbox.people.people') }}/{id}" done="{{ t('The person is saved as a draft.') }}">
        <form class="fb-card fb-card--padded fb-stack" novalidate>
            {{ ui.field({label: t('Given name'), name: 'givenName', id: 'person-given-name', attrs: {maxlength: 100, autocomplete: 'off'}}) }}
            {{ ui.field({label: t('Family name'), name: 'familyName', id: 'person-family-name', required: true, attrs: {maxlength: 100, autocomplete: 'off'}}) }}
            {{ ui.field({label: t('Role'), name: 'translations.' ~ language.code ~ '.role', id: 'person-role', optional: true, hint: t('What the person does, e.g. "Head roaster".'), attrs: {lang: language.code, dir: language.direction.value, maxlength: 200}}) }}
            <div class="fb-form__actions">
                {{ ui.button({label: t('Save as a draft'), type: 'submit'}) }}
                {{ ui.button({label: t('Cancel'), variant: 'ghost', href: path('frootbox.people.people')}) }}
            </div>
        </form>
    </fb-form>
</div>
{% endblock %}
